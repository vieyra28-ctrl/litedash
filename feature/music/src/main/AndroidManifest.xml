<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Para saber qué apps de música hay instaladas (las que ofrecen su biblioteca). -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Reproductores que aceptan el botón de play (los de USB y Bluetooth de la pantalla). -->
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- El servicio de comandos de las pantallas TopWay (solo para saber si está, en los reportes). -->
        <intent>
            <action android:name="com.tw.service.xt.CommandService.Bind" />
        </intent>
        <!-- Apps de Bluetooth de marca (chip propio): para reconocer la familia en los reportes. -->
        <package android:name="com.syu.bt" />
        <package android:name="com.syu.ms" />
        <package android:name="com.fyt.bt" />
        <package android:name="com.tw.bt" />
        <package android:name="com.tw.service" />
        <package android:name="com.ts.bt" />
        <package android:name="com.microntek.bt" />
        <package android:name="com.goodocom.gocsdk" />
        <package android:name="com.autochips.bluetooth" />
        <package android:name="com.yftech.service.bluetooth" />
        <!-- La radio de las pantallas NWD: su sintonizador y el kernel que elige qué suena. -->
        <package android:name="com.nwd.radio.service" />
        <package android:name="com.nwd.kernel" />
        <!-- Radio FM de las pantallas Hengchen (HCN): su servicio FMPlugService. -->
        <package android:name="com.hcn.autoradio" />
    </queries>
    <!-- Algunas radios HCN piden este permiso para hablar con su servicio (si es de firma, no se concede y no pasa nada). -->
    <uses-permission android:name="hcn.permission.FM_PLUG_SERVICE" />
    <!-- El nombre del celular conectado por Bluetooth (la pieza lo muestra cuando la app no manda la canción). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Vincular el celular desde Ajustes: buscar (Android 12+, nunca ligado a la ubicación) y emparejar. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <application>
        <!--
            Existe para que el usuario pueda dar "acceso a notificaciones": con
            ese permiso Android deja leer qué suena en otras apps. De los avisos
            solo se miran el de la app de navegación (la siguiente vuelta) y los
            de las apps de Bluetooth y radio enlazadas (qué suena); no se guarda nada.
        -->
        <service
            android:name="com.vieyra28.litekia.feature.musica.ServicioMusica"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
